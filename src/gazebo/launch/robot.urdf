<?xml version="1.0" ?>
<!-- Visual model of the robot for Foxglove. Link names match the TF frames the simulator publishes,
     and joint origins match robot_env.sdf (wheels and caster relative to the chassis). -->
<robot name='robot'>
    <material name="blue"><color rgba="0.0 0.0 1.0 1.0"/></material>
    <material name="red"><color rgba="1.0 0.0 0.0 1.0"/></material>
    <material name="green"><color rgba="0.0 1.0 0.0 1.0"/></material>

    <link name='robot/chassis'>
        <visual>
            <geometry>
                <box size="2.0 1.0 0.5"/>
            </geometry>
            <material name="blue"/>
        </visual>
    </link>

    <link name='robot/left_wheel'>
        <visual>
            <geometry>
                <cylinder radius="0.4" length="0.2"/>
            </geometry>
            <material name="red"/>
        </visual>
    </link>

    <link name='robot/right_wheel'>
        <visual>
            <geometry>
                <cylinder radius="0.4" length="0.2"/>
            </geometry>
            <material name="red"/>
        </visual>
    </link>

    <link name='robot/caster'>
        <visual>
            <geometry>
                <sphere radius="0.2"/>
            </geometry>
            <material name="green"/>
        </visual>
    </link>

    <joint name='left_wheel_joint' type='continuous'>
        <parent link='robot/chassis'/>
        <child link='robot/left_wheel'/>
        <origin xyz="-0.5 0.6 0" rpy="-1.5707 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <joint name='right_wheel_joint' type='continuous'>
        <parent link='robot/chassis'/>
        <child link='robot/right_wheel'/>
        <origin xyz="-0.5 -0.6 0" rpy="-1.5707 0 0"/>
        <axis xyz="0 0 1"/>
    </joint>

    <joint name='caster_joint' type='fixed'>
        <parent link='robot/chassis'/>
        <child link='robot/caster'/>
        <origin xyz="0.8 0 -0.2"/>
    </joint>
</robot>
